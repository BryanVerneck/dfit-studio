DATABASE_URL=postgres://dfit:dfit@localhost:5432/dfit
PORT=3000

# At least 32 random characters, e.g. `openssl rand -base64 48`. Never commit the real one.
JWT_SECRET=change-me-change-me-change-me-change-me

# Used once by `pnpm --filter @dfit/api db:seed` to create the studio and its first owner.
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-please
# SEED_OWNER_NAME=Owner
# SEED_STUDIO_SLUG=dfit
# SEED_STUDIO_TIMEZONE=America/Sao_Paulo

# Optional
# AUTH_RATE_LIMIT_PER_MINUTE=10
# TRUST_PROXY=true   # set when deployed behind a hosting proxy
